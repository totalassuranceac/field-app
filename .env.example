# Copy values into Cloudflare Worker secrets / vars (wrangler secret put ...)
# or a local .dev.vars file for wrangler dev.

SESSION_SECRET=generate-a-long-random-string
APP_BASE_URL=http://127.0.0.1:8787

# Google Workspace OAuth (optional for local password-only testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. totalassurance.com  (no @)
WORKSPACE_DOMAIN=
# Optional comma-separated extra emails allowed via Google
GOOGLE_ALLOWED_EXTRA=

APP_NAME=Total Assurance Fleet

# GPS providers (Worker secrets — never commit real passwords)
ONESTEP_USER=
ONESTEP_PASS=
VERIZON_USER=
VERIZON_PASS=
